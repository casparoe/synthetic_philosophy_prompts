# Settings for rendering arXiv sources to text (tools/arxiv_latexml.py),
# preloaded before every paper.
package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;

# Go on past errors rather than give up after 100: they are mostly macros that
# LaTeXML cannot define (from packages it does not support), which cost only
# their own output, and the text is taken without LaTeXML's error markers.
AssignValue(MAX_ERRORS => 100000, 'global');

1;
